# Copie para operoz-mcp.env na VPS (não commitar tokens):
#   cp operoz-mcp.env.example operoz-mcp.env

# URL pública da API Operoz (usada pelo MCP para chamar a API)
OPEROZ_API_BASE_URL=https://operoz.io

# Imagem após deploy (GHCR → tag local)
MCP_IMAGE=myoperoz/operoz-mcp:stable

# Host permitido no header Host (proteção DNS rebinding do SDK MCP).
# ATENÇÃO: se estiver desatualizado, bloqueia também /authorize e /token, não só /mcp.
MCP_ALLOWED_HOSTS=mcp.operoz.io,127.0.0.1,localhost

# Publicação no host. NPM (Docker) precisa alcançar a porta — use 0.0.0.0 (não 127.0.0.1).
MCP_PUBLISH=0.0.0.0:3100

# OPEROZ_API_KEY não vai aqui — cada utilizador envia o token no Cursor (header Authorization).

# ---------------------------------------------------------------------------
# OAuth 2.1 — conectores do Claude Desktop / claude.ai
# ---------------------------------------------------------------------------
# LIGAR AQUI SÓ DEPOIS DE VALIDAR EM HML (deployments/mcp-hml/).
#
# Clientes antigos (token estático em X-Api-Key / Authorization: Bearer) continuam
# a funcionar sem qualquer alteração, com ou sem OAuth ligado.
#
# PRÉ-REQUISITO no Nginx Proxy Manager: encaminhar a RAIZ (`/`), não só `/mcp`.
# Com OAuth ligado existem endpoints fora de /mcp: /.well-known/*, /authorize,
# /token, /register, /revoke, /oauth/pending/*, /oauth/web-callback.

# Base HTTPS pública deste MCP. A PRESENÇA desta variável liga o OAuth.
MCP_OAUTH_ISSUER_URL=https://mcp.operoz.io

# Kill switch explícito (opcional). "false" desliga o OAuth mesmo com issuer setado.
# MCP_OAUTH_ENABLED=true

# Identificador de recurso (RFC 8707/9728). Default: ${MCP_OAUTH_ISSUER_URL}/mcp
# MCP_OAUTH_RESOURCE_URL=https://mcp.operoz.io/mcp

# Caminho do JSON store dentro do volume nomeado. Tratar como um .env: contém o
# APIToken Operoz em texto puro. Modo 0600, fora de backups que saiam da VPS.
MCP_OAUTH_STORE_PATH=/data/oauth-store.json

# Base do apps/web para onde o /authorize redireciona; a URL final é
# ${MCP_OAUTH_WEB_BASE_URL}/mcp-authorize/<ticket>. OBRIGATÓRIO com OAuth ligado.
# Tem de ser exatamente o host que serve o app (o build de produção do frontend
# usa https://www.operoz.io como VITE_API_BASE_URL).
MCP_OAUTH_WEB_BASE_URL=https://www.operoz.io

# Allowlist de Origin para o CORS de /oauth/pending/* (CSV). Apex E www estão
# ambos no ar (um redireciona para o outro), por isso as duas variantes entram.
MCP_OAUTH_WEB_ORIGINS=https://operoz.io,https://www.operoz.io

# TTLs (segundos)
MCP_OAUTH_ACCESS_TOKEN_TTL=3600
MCP_OAUTH_REFRESH_TOKEN_TTL=2592000
MCP_OAUTH_CODE_TTL=120
MCP_OAUTH_PENDING_TTL=600

# Escopos anunciados (CSV)
MCP_OAUTH_SCOPES=mcp:tools

# Cap de clientes DCR antes da eviction LRU
MCP_OAUTH_MAX_CLIENTS=500

# Intervalo (s) de revalidação do APIToken Operoz por trás de cada access token.
# É o atraso máximo entre revogar o token em Definições e o conector parar.
MCP_OAUTH_REVALIDATE_INTERVAL=300

# Prefixo do label do APIToken mintado (visível em Definições → API tokens).
# Quem monta "<prefixo> · <client_name>" é o Django, com MCP_OAUTH_TOKEN_LABEL_PREFIX.
MCP_OAUTH_TOKEN_LABEL_PREFIX=MCP OAuth

# SEGREDO PARTILHADO com o apps/api — autentica POST /oauth/web-callback (HMAC-SHA256).
# TEM de bater byte a byte com MCP_WEB_CALLBACK_SECRET do lado da API. Do lado da
# API em PRODUÇÃO esse valor vive no `operoz.env` residente NA VPS (OPEROZ_APP_PATH,
# default /root/operis-selfhost/operoz-app), FORA deste repositório — edição manual.
# Sem ele, /oauth/web-callback responde 503 (funcionalidade desligada, não partida).
#
# Aceita LISTA separada por vírgula: o mcp-server valida contra QUALQUER entrada, e
# o Django assina sempre com a PRIMEIRA. Rotação sem downtime, em duas etapas:
#   1. mcp-server: MCP_WEB_CALLBACK_SECRET=<antigo>,<novo>  → redeploy
#   2. api:        MCP_WEB_CALLBACK_SECRET=<novo>           → redeploy
#   3. mcp-server: MCP_WEB_CALLBACK_SECRET=<novo>           → redeploy
#
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_WEB_CALLBACK_SECRET=

# Hop count do trust proxy do Express. Sem isto, o express-rate-limit v8 dos
# handlers OAuth do SDK rebenta atrás do NPM (ERR_ERL_UNEXPECTED_X_FORWARDED_FOR).
MCP_TRUST_PROXY=1
