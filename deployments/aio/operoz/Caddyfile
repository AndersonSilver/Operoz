{
	auto_https off
	# TLS termina no proxy de borda (Nginx Proxy Manager); sem isto o Caddy
	# descarta o X-Forwarded-Proto recebido e o Django ve a requisicao como HTTP,
	# gerando redirect_uri OAuth em http:// (redirect_uri_mismatch).
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

:8080 {
	request_body {
		max_size {$FILE_SIZE_LIMIT:5242880}
	}

	redir /spaces /spaces/ permanent
	handle /spaces/* {
		reverse_proxy 127.0.0.1:3002
	}

	redir /god-mode /god-mode/ permanent
	handle_path /god-mode/* {
		root * /app/admin
		try_files {path} {path}/ /index.html
		file_server
	}

	handle /live/* {
		reverse_proxy 127.0.0.1:3005
	}

	# Upstreams por 127.0.0.1, nunca localhost: o gunicorn escuta so em IPv4
	# e o Caddy, ao resolver localhost, pode tentar ::1 e devolver 502
	# (dial tcp [::1]:8000: connect: connection refused).
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}

	handle /auth/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /static/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Web fica em container separado — alcancado pelo hostname de rede
	# (docker-compose service name / Azure Container Apps internal DNS).
	handle {
		reverse_proxy {$WEB_UPSTREAM:web}:3000
	}
}
