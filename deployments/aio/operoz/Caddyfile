{
	auto_https off
}

:8080 {
	request_body {
		max_size {$FILE_SIZE_LIMIT:5242880}
	}

	redir /spaces /spaces/ permanent
	handle /spaces/* {
		reverse_proxy localhost:3002
	}

	redir /god-mode /god-mode/ permanent
	handle_path /god-mode/* {
		root * /app/admin
		try_files {path} {path}/ /index.html
		file_server
	}

	handle /live/* {
		reverse_proxy localhost:3005
	}

	@assistant_chat path /api/workspaces/*/assistant/sessions/*/chat* /api/workspaces/*/assistant/chat/jobs/*/stream*
	handle @assistant_chat {
		reverse_proxy localhost:8001 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy localhost:8000 {
			flush_interval -1
		}
	}

	handle /auth/* {
		reverse_proxy localhost:8000
	}

	handle /static/* {
		reverse_proxy localhost:8000
	}

	# Web fica em container separado — alcancado pelo hostname de rede
	# (docker-compose service name / Azure Container Apps internal DNS).
	handle {
		reverse_proxy {$WEB_UPSTREAM:web}:3000
	}
}
