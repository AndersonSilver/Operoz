# Backend
# Debug value for api server use it as 0 for production use
DEBUG=0

# REQUIRED: generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY="CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET"

# REQUIRED: comma-separated list of allowed host headers
ALLOWED_HOSTS="localhost,127.0.0.1"

CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3100"

# Database Settings
POSTGRES_USER="operoz"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
POSTGRES_HOST="operoz-db"
POSTGRES_DB="operoz"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST="operoz-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"


# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
# Browser-reachable MinIO URL for presigned uploads when the API is not behind /uploads reverse proxy
# (e.g. docker-compose-local: set to http://localhost:9000). Leave empty when nginx proxies /uploads on WEB_URL.
MINIO_PUBLIC_ENDPOINT_URL=""
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# Settings related to Docker
DOCKERIZED=1 # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=0



# Public API origin (emails, OAuth callbacks, /api/* from browser when split from SPA).
# Local dev with separate ports: API on :8000. Production behind proxy: same as WEB_URL / public domain.
WEB_URL="http://localhost:8000"

# Gunicorn Workers
GUNICORN_WORKERS=2
# Pooler de conexoes. O container proprio foi removido; use o pooler gerenciado
# (Azure PG Flexible expoe PgBouncer na 6432 via a flag pgbouncer.enabled).
# Com 1, o Django desliga cursor server-side e reuso de conexao — obrigatorio sob
# transaction pooling, senao os .iterator() das tasks quebram em runtime.
USE_PGBOUNCER=0
# DATABASE_URL=postgresql://user:pass@SEU-SERVIDOR.postgres.database.azure.com:6432/operoz

# Base URLs
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

# Main SPA (guest links, auth redirects). Local dev: :3000. Production: public app URL (often same as WEB_URL).
APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# Hard delete files after days
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# Production HTTPS / HSTS settings (production.py only)
# Set SECURE_SSL_REDIRECT=0 if SSL terminates at the load balancer/nginx (not at Django).
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000

# Trusted proxy IPs for X-Forwarded-For resolution (comma-separated).
# Required in cloud/k8s environments so user IPs are correctly logged.
# Example: TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2
# TRUSTED_PROXY_IPS=

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# Discord Bot (slash commands + alertas DM)
# DISCORD_APPLICATION_ID=""
# DISCORD_BOT_TOKEN=""
# DISCORD_PUBLIC_KEY=""

# Discord OAuth2 (ligar conta do utilizador — scope identify)
# DISCORD_OAUTH_CLIENT_ID=""
# DISCORD_OAUTH_CLIENT_SECRET=""
# Opcional se WEB_URL já aponta para a API pública:
# DISCORD_OAUTH_REDIRECT_URI="http://localhost:8000/api/integrations/discord/auth/callback/"

# Google Calendar OAuth (Settings → Notificações → Contas externas)
# Para auto-ligar Calendar no login Google, use o MESMO Client ID/Secret do login
# (GOOGLE_CLIENT_ID) aqui — caso contrário o token guardado no login não refresca.
# GOOGLE_CALENDAR_CLIENT_ID=""
# GOOGLE_CALENDAR_CLIENT_SECRET=""
# Opcional se WEB_URL já aponta para a API pública:
# GOOGLE_CALENDAR_OAUTH_REDIRECT_URI="http://localhost:8000/api/integrations/google-calendar/auth/callback/"

# Indice RAG / busca semantica (o assistant-chat foi removido; sobrou a
# indexacao, consumida por /api/v1/.../search/semantic/ e pelo MCP)
LLM_API_KEY=""
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""
# Os nomes antigos ASSISTANT_* continuam sendo lidos como fallback enquanto os
# .env dos servidores nao migram. O valor da fila segue "assistant": renomear
# exigiria reiniciar os workers em sincronia e perderia o que estivesse em voo.
RAG_CELERY_QUEUE="assistant"
# 0 desliga a ESCRITA no indice (para de gastar embedding). RAG_ENABLED
# controla so a LEITURA.
RAG_INDEXING_ENABLED="1"
RAG_INDEX_RATE_LIMIT_MAX_RETRIES="8"
RAG_INDEX_RATE_LIMIT_BACKOFF_SECONDS="30"
RAG_WORKER_CONCURRENCY="2"
# Com LLM_PROVIDER=gemini usa gemini-embedding-001 (1536 dims) por default.
RAG_EMBEDDING_MODEL="text-embedding-3-small"
RAG_QUERY_EMBEDDING_CACHE_TTL="600"
RAG_RESULTS_CACHE_TTL="180"
RAG_HNSW_EF_SEARCH="40"
# LLM_API_KEYS="sk-a,sk-b"
CELERY_QUEUE_ALERT_THRESHOLD="500"

# ---------------------------------------------------------------------------
# Conectores MCP (OAuth 2.1 do operoz-mcp)
# ---------------------------------------------------------------------------
# Alimentam POST /api/users/mcp-connectors/authorize/ (e .../deny/), o passo em que
# o Django minta o APIToken do utilizador e o entrega ao mcp-server num POST
# assinado. Faltando qualquer uma das duas, o endpoint responde 503 (funcionalidade
# desligada, não partida) — nada mais no produto é afetado.
#
# ONDE PÔR O VALOR DE PRODUÇÃO: não é aqui. Não existe .env de produção da API no
# repositório — o arquivo é o `operoz.env` residente NA VPS, em OPEROZ_APP_PATH
# (default /root/operis-selfhost/plane-app), e o serviço `api` do docker-compose.yaml
# TAMBÉM residente na VPS precisa repassar as duas variáveis. Nenhum script de deploy
# escreve isso. Em HML o caminho é deployments/hml/docker-compose.yaml, que está no repo.

# Segredo partilhado com o mcp-server (MCP_WEB_CALLBACK_SECRET de lá). Tem de bater
# BYTE A BYTE. Aceita CSV: assinamos sempre com o PRIMEIRO da lista e o mcp-server
# aceita qualquer um — é o que permite rotação sem downtime.
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_WEB_CALLBACK_SECRET=""

# Base do mcp-server chamada servidor-a-servidor. Pode ser interna
# (http://operoz-mcp:3100) se os containers se enxergarem.
MCP_WEB_CALLBACK_BASE_URL=""

# Prefixo do label do APIToken mintado (o Django monta "<prefixo> · <client_name>").
MCP_OAUTH_TOKEN_LABEL_PREFIX="MCP OAuth"

# Timeout (s) das chamadas ao mcp-server. Curto: o utilizador está à espera no browser.
MCP_WEB_CALLBACK_TIMEOUT="5"
