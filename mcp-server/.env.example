# Base URL da API Operoz (sem barra final)
OPEROZ_API_BASE_URL=http://localhost:8000

# Token de API (God mode / Definições → API tokens). Cobre /api/v1/* e /api/* (boards, Cliente 360, etc.)
OPEROZ_API_KEY=

# Perfil MCP: agent (default, 7 tools — discover+execute) | full (676 tools, 1 por endpoint)
OPEROZ_MCP_PROFILE=agent

# Legado: só necessário se preferires autenticar /api/* por sessão em vez de OPEROZ_API_KEY.
# Preenchido por operoz_sign_in ou manualmente:
# OPEROZ_SESSION_COOKIE=sessionid=...

# ---------------------------------------------------------------------------
# OAuth 2.1 (modo HTTP) — conectores do Claude Desktop / claude.ai
# ---------------------------------------------------------------------------
# Só vale para `npm run dev:http` / `npm run start:http`. Não afeta o modo stdio,
# nem os clientes que já usam token estático (X-Api-Key / Authorization: Bearer).
# Ver deployments/mcp-hml/operoz-mcp-hml.env.example para a lista completa.
#
# Setup local completo (web em :3000, API em :8000, MCP em :3100):
# MCP_OAUTH_ISSUER_URL=http://localhost:3100
# MCP_OAUTH_WEB_BASE_URL=http://localhost:3000
# MCP_OAUTH_WEB_ORIGINS=http://localhost:3000
# MCP_OAUTH_STORE_PATH=./.oauth-store.json
# MCP_WEB_CALLBACK_SECRET=segredo-local-igual-ao-do-django
# MCP_TRUST_PROXY=0
